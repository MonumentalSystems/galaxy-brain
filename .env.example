POSTGRES_DB=galaxy_brain
POSTGRES_USER=galaxy_brain_migrator
POSTGRES_PASSWORD=replace-with-a-long-random-migration-value
# In Coolify, store production credentials in these normal, editable,
# runtime-only source variables. Empty values keep local development on the
# legacy names below; GALAXY_DEPLOY_* wins when both are present.
GALAXY_DEPLOY_POSTGRES_PASSWORD=
GALAXY_DEPLOY_DATABASE_MIGRATION_URL=
GALAXY_DEPLOY_DATABASE_URL=
GALAXY_DEPLOY_GB_DATABASE_URL=
GALAXY_DEPLOY_GB_PROOF_VERIFIER_DATABASE_URL=
GALAXY_DEPLOY_REGISTRATION_INVITE_CODE=
GALAXY_DEPLOY_GALAXY_API_PROXY_TOKEN=
GALAXY_DEPLOY_OBJECT_REFERENCE_RESOLVER_TOKEN=
GALAXY_DEPLOY_DOCLING_API_KEY=
GALAXY_DEPLOY_MARKITDOWN_PROXY_TOKEN=
GALAXY_DEPLOY_SMTP_URL=
GALAXY_DEPLOY_HAM_API_BEARER_TOKEN=
GALAXY_DEPLOY_HAM_TASK_READ_BEARER_TOKEN=
GALAXY_DEPLOY_HAM_TASK_WRITE_BEARER_TOKEN=
GALAXY_DEPLOY_HAM_ADMIN_API_BEARER_TOKEN=
GALAXY_DEPLOY_HYADES_PROGRAM_OPERATOR_BEARER_TOKEN=
GALAXY_DEPLOY_HYADES_TASK_PLAN_OPERATOR_BEARER_TOKEN=
# The explicit local Compose override provisions these two non-owner roles only
# after migrations finish. Use a different random password for each role.
LOCAL_WEB_DATABASE_ROLE=galaxy_brain_web
LOCAL_WEB_DATABASE_PASSWORD=replace-with-a-long-random-web-value
LOCAL_API_DATABASE_ROLE=galaxy_brain_api
LOCAL_API_DATABASE_PASSWORD=replace-with-a-long-random-api-value
DATABASE_URL=postgres://galaxy_brain_web:replace-with-a-long-random-web-value@postgres:5432/galaxy_brain
GB_DATABASE_URL=postgres://galaxy_brain_api:replace-with-a-long-random-api-value@postgres:5432/galaxy_brain
# Optional trusted proof verifier login. It must be distinct from both runtime
# roles; the provisioner grants it only membership in gb_proof_verifier. Leave
# all three empty to keep POST .../verify fail-closed with HTTP 503.
LOCAL_VERIFIER_DATABASE_ROLE=
LOCAL_VERIFIER_DATABASE_PASSWORD=
GB_PROOF_VERIFIER_DATABASE_URL=
DATABASE_MIGRATION_URL=postgres://galaxy_brain_migrator:replace-with-a-long-random-migration-value@postgres:5432/galaxy_brain
AUTH_SESSION_DAYS=30
AUTH_ORIGIN=http://localhost:3001
# Exact callback allowed for the simple Nostr account-link flow.
CONNECT_CALLBACK_URL=http://localhost:3000/api/galaxy-brain/connect/callback
# Legacy alias; CONNECT_CALLBACK_URL wins when both are present.
GENEROUS_CONNECT_CALLBACK_URL=
WEB_HOST_PORT=3001
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Galaxy Brain
AUTH_RECOVERY_CONTACT=
SMTP_URL=
AUTH_EMAIL_FROM=
REGISTRATION_INVITE_CODE=replace-with-a-separate-random-value
GALAXY_API_PROXY_TOKEN=replace-with-a-separate-random-value
GB_OBJECT_REFERENCE_RESOLVER_URL=
GB_OBJECT_REFERENCE_RESOLVER_TOKEN=
# To use Galaxy's built-in HAM-only resolver, point the API at the deployed
# HTTPS URL ending in /api/internal/object-references/resolve and share the
# same token with the web service. Unsupported provider kinds remain denied.
MARKITDOWN_PROXY_TOKEN=replace-with-a-separate-random-value
# The fallback worker must finish before Galaxy API's fixed 120-second request
# deadline. Values are clamped to 5-110 seconds by the service.
MARKITDOWN_TIMEOUT_SECONDS=105
MARKITDOWN_MAX_OUTPUT_MB=16
MARKITDOWN_MAX_CONCURRENT_WORKERS=2
# JSON object mapping each authorized Galaxy tenant UUID to absolute container roots.
GB_DATASOURCE_ALLOWED_ROOTS_BY_TENANT={}
# Authenticated read-only HAM search BFF. The server maps the signed-in user to
# X-GB-User-ID and exposes only the allowlisted scoped retrieval operations.
# Keep this credential server-only and separate from task and admin credentials.
HAM_API_INTERNAL=http://host.docker.internal:8042
HAM_API_BEARER_TOKEN=
# Bind the deployment-global search credential to exactly one Galaxy tenant.
# Other tenants fail closed until they receive a separately provisioned mapping.
HAM_SEARCH_GALAXY_TENANT_ID=00000000-0000-4000-8000-000000000001
# Exact memory reads and authenticated interactive changes reuse the
# existing scoped HAM connection. No HAM credential is exposed to the browser.
HAM_TASK_API_INTERNAL=
# Server-only HAM task transport. Project membership is organizational only;
# Hyades separately authorizes workflow execution.
HAM_TASK_READ_BEARER_TOKEN=
# Mutations are disabled by default. Use a separate write transport credential
# only when Galaxy Brain task posting is explicitly enabled.
HAM_TASK_MUTATIONS=disabled
HAM_TASK_WRITE_BEARER_TOKEN=
HAM_TASK_PROJECT_REF=galaxy-brain
# Only this Galaxy tenant may use the deployment-global HAM project/credentials.
HAM_TASK_GALAXY_TENANT_ID=
# Owner/admin proof-campaign control. The endpoint may be Hyades directly
# when Galaxy Brain has private network reachability, or a narrow service
# service bridge preserving these allowlisted routes. Never use NEXT_PUBLIC.
HYADES_PROGRAM_CONTROL_API_INTERNAL=
HYADES_PROGRAM_OPERATOR_BEARER_TOKEN=
HYADES_PROGRAM_TENANT=
HYADES_PROGRAM_HAM_PROJECT=
PROOF_CAMPAIGN_GALAXY_TENANT_ID=
PROOF_CAMPAIGN_MUTATIONS=disabled
PROOF_CAMPAIGN_MAX_SESSION_AGE_MINUTES=15
# Server-only Task Constructor run adapter. The browser can select only an
# exact saved plan revision; tenant, project, executor, workspace, and authority
# remain deployment-selected. Keep mutations disabled until Hyades is deployed
# with the saved-plan dispatch route, a bound executor, and an enabled keyring.
HYADES_TASK_PLAN_API_INTERNAL=
HYADES_TASK_PLAN_OPERATOR_BEARER_TOKEN=
HYADES_TASK_PLAN_TENANT=
HYADES_TASK_PLAN_HAM_PROJECT=galaxy-brain
TASK_PLAN_EXECUTOR_GALAXY_TENANT_ID=
TASK_PLAN_RUN_MUTATIONS=disabled
TASK_PLAN_EXECUTOR_MAX_SESSION_AGE_MINUTES=15
# Read-only complete Hyades task-binding projection. Galaxy derives the exact
# program route from its selected immutable graph; never expose these publicly.
HYADES_PROOF_TASK_BINDINGS_API_INTERNAL=
HYADES_PROOF_TASK_BINDINGS_BEARER_TOKEN=
# Owner-only HAM access administration. Use a private/internal service URL and
# a separately managed administrator credential. Never expose these as
# NEXT_PUBLIC variables or reuse either task credential.
HAM_ADMIN_API_INTERNAL=
HAM_ADMIN_API_BEARER_TOKEN=
HAM_ADMIN_TENANT_ID=
# Exact Galaxy owner allowed to exercise the deployment-global HAM credential.
HAM_ADMIN_GALAXY_TENANT_ID=
HAM_ADMIN_GALAXY_PRINCIPAL_ID=
HAM_ADMIN_OWNER_NOSTR_PUBKEY=
HAM_ADMIN_MAX_SESSION_AGE_MINUTES=15
MARKITDOWN_API_INTERNAL=http://markitdown:8043
# Private Docling Serve contribution. Compose fixes the API URL internally;
# callers and browsers cannot supply or observe a conversion destination.
DOCLING_API_INTERNAL=http://docling:5001
DOCLING_API_KEY=
# Docling engine version bundled by the pinned v1.35.0 CPU image.
DOCLING_ENGINE_VERSION=2.130.0
GALAXY_API_INTERNAL=http://galaxy-brain-api:8044
# Expose the /dev/* design previews on a deployed instance. Defaults closed;
# set to exactly "true" to opt in. Previews are always on in development.
GALAXY_DEV_PREVIEWS=
# Prove2me (https://prove2.me) supplies Lean 4 proof decomposition graphs.
# The API key is exchanged server-side for short-lived access tokens and is
# never sent to the browser. Leave empty to disable the integration; the proxy
# then answers 503.
PROVE2ME_API_KEY=
PROVE2ME_API_URL=https://prove2.me/api/v1
