      "schema",
      "catalog",
      "surfaceUpdate",
      "bindings"
    ],
    "bounds": {
      "maxComponents": 64,
      "maxBindings": 64,
      "maxJsonBytes": 262144,
      "maxStringLength": 20000,
      "maxDepth": 10,
      "maxValueNodes": 4096
    },
    "identifierPattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
    "forbiddenPropertyNames": [
      "action",
      "actions",
      "constructor",
      "dangerouslySetInnerHTML",
      "handler",
      "prototype",
      "script",
      "srcDoc",
      "__proto__"
    ],
    "forbiddenPropertyPattern": "^on[A-Z_]",
    "forbiddenStringFragments": [
      "javascript:",
      "<script"
    ]
  },
