{
  "schema": "gb.surface.v1",
  "catalog": {
    "id": "generous.a2ui",
    "version": "1"
  },
  "surfaceUpdate": {
    "surfaceId": "research-board",
    "components": [
      {
        "id": "board",
        "component": {
          "Column": {
            "align": "stretch"
          }
        },
        "children": [
          "board-title",
          "board-stats",
          "experiment-table"
        ]
      },
      {
        "id": "board-title",
        "parentId": "board",
        "component": {
          "Title": {
            "text": "Research Board",
            "usageHint": "h1"
          }
        }
      },
      {
        "id": "board-stats",
        "parentId": "board",
        "component": {
          "StatsDisplay": {
            "id": "research-stats",
            "title": "Research activity",
            "stats": [
              {
                "key": "running",
                "label": "Running experiments",
                "value": 1,
                "format": {
                  "kind": "number",
                  "decimals": 0
                }
              }
            ]
          }
        }
      },
      {
        "id": "experiment-table",
        "parentId": "board",
        "component": {
          "DataTable": {
            "data": {
              "title": "Experiments",
              "columns": [
                {
                  "id": "title",
                  "header": "Experiment",
                  "accessorKey": "title"
                },
                {
                  "id": "status",
                  "header": "Status",
                  "accessorKey": "status"
                }
              ],
              "rows": [
                {
                  "title": "Parser reliability",
                  "status": "running"
                }
              ]
            },
            "options": {
              "enableSorting": true,
              "enablePagination": false,
              "striped": true
            }
          }
        }
      }
    ]
  },
  "bindings": [
    {
      "id": "experiment-rows",
      "target": {
        "componentId": "experiment-table",
        "prop": "data.rows"
      },
      "source": {
        "kind": "galaxy.eln.experiment",
        "query": {
          "status": "running"
        }
      }
    },
    {
      "id": "activity-stats",
      "target": {
        "componentId": "board-stats",
        "prop": "stats"
      },
      "source": {
        "kind": "galaxy.eln.experiment",
        "query": {
          "aggregate": "status"
        }
      }
    }
  ]
}
